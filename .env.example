# ═══════════════════════════════════════════════════════════
#  SPORTS-MAX — Plantilla de variables de entorno (sin secretos reales)
#  Copia este archivo a ".env" en local, o cárgalas en el panel de Render/Docker.
# ═══════════════════════════════════════════════════════════
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=False
# Pruebas rápidas: *   |   Producción: proyecto2026.onrender.com
ALLOWED_HOSTS=*
# CSRF_TRUSTED_ORIGINS=https://proyecto2026.onrender.com

# ── Correo ──────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── Base de datos ───────────────────────────────────────────
# Sin DB_NAME/DB_USER el proyecto usa SQLite (ideal para la primera prueba en Docker;
# en Render el disco es temporal, así que los datos se pierden en cada despliegue).
#
# CONEXIÓN CON MYSQL WORKBENCH (local) — COMENTADA mientras se sube a Docker.
# Quita los "#" para volver a usarla en tu PC:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=nombre_de_tu_esquema
# DB_USER=root
# DB_PASSWORD=tu_clave
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ── Motor de IA (servidor Flask aparte: scripts/ia_server.py) ──
IA_SERVER_URL=http://127.0.0.1:5001
GEMINI_API_KEY=
